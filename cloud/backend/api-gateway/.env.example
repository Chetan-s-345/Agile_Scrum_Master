# Universal DB (Supabase or main Neon project)
UNIVERSAL_DATABASE_URL=postgresql://user:password@host/universal_db

# Tenant DB strategy:
# - manual: tenant DB connection string is provided during org setup/invite flow
# - neon: API creates a Neon project per org automatically
TENANT_DB_PROVISIONING_MODE=manual

# Required when TENANT_DB_PROVISIONING_MODE=neon
NEON_API_KEY=your_neon_api_key

# Payment gateway
# - mock: local/testing checkout link
# - stripe: real Stripe checkout session
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Auth
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_secret
REFRESH_EXPIRES_IN=30d

# Redis
REDIS_URL=redis://localhost:6379

# Optional: Background queues/workers (BullMQ) require Redis.
# If you don't have Redis running locally, set these to false.
ENABLE_SCHEDULER=false
ENABLE_WORKERS=false

# AI Service
AI_SERVICE_URL=http://localhost:8000

# RAG Embeddings
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSIONS=1536

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Jira OAuth
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret

# GitHub
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Google Meet (Calendar conference creation)
# Option A: provide full service account JSON (single-line escaped JSON string)
GOOGLE_MEET_SERVICE_ACCOUNT_JSON=
# Option B: provide individual values
GOOGLE_MEET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_MEET_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional: use a specific calendar instead of service account primary calendar
GOOGLE_MEET_CALENDAR_ID=primary
# Optional: Workspace domain-wide delegation impersonation user
GOOGLE_MEET_IMPERSONATE_USER=
