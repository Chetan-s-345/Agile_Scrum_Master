# Universal DB (Supabase or main Neon project)
UNIVERSAL_DATABASE_URL=postgresql://user:password@host/universal_db

# Tenant DB strategy:
# - manual: tenant DB connection string is provided during org setup/invite flow
# - neon: API creates a Neon project per org automatically
TENANT_DB_PROVISIONING_MODE=manual

# Required when TENANT_DB_PROVISIONING_MODE=neon
NEON_API_KEY=your_neon_api_key

# Payment gateway
# - mock: local/testing checkout link
# - stripe: real Stripe checkout session
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Auth
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_secret
REFRESH_EXPIRES_IN=30d

# Redis
REDIS_URL=redis://localhost:6379

# Optional: Background queues/workers (BullMQ) require Redis.
# If you don't have Redis running locally, set these to false.
ENABLE_SCHEDULER=false
ENABLE_WORKERS=false

# AI Service
AI_SERVICE_URL=http://localhost:8000

# RAG Embeddings
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSIONS=1536

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Inngest event dispatch (used by gateway webhooks + meeting automation)
# In local development, prefer INNGEST_DEV_URL=http://127.0.0.1:8288/e/local
INNGEST_DEV_URL=
INNGEST_LOCAL_DEV=true
INNGEST_EVENT_URL=
INNGEST_EVENT_KEY=

# Jira OAuth
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret

# GitHub
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# LiveKit + Deepgram meetings
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
DEEPGRAM_API_KEY=

# Email invites and assignment notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=scrum@yourdomain.com

# Claude task assignment
ANTHROPIC_API_KEY=
