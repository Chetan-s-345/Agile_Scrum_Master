# AI Service (FastAPI)
# uvicorn app.main:app --reload --port 8000

# Optional but recommended for persistence of ML predictions in Postgres/Neon.
DATABASE_URL=

# Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# GitNexus - E2B Repository Analysis Engine
E2B_API_KEY=
E2B_TEMPLATE=agile-gitnexus-runtime

# GitHub (required for repository analysis and API quota estimation)
GITHUB_TOKEN=