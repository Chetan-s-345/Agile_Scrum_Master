#==================== DATABASE ====================
DB_USER=sprint_user
DB_PASSWORD=sprint_password
DB_NAME=sprint_manager
DB_PORT=5432
DATABASE_URL=postgresql://sprint_user:sprint_password@localhost:5432/sprint_manager

# ==================== REDIS ====================
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ==================== API GATEWAY ====================
API_PORT=4000
API_GATEWAY_URL=http://localhost:4000
NODE_ENV=development
NEXTAUTH_SECRET=your_nextauth_secret_change_me_in_production
JWT_SECRET=your_jwt_secret_change_me_in_production

# ==================== AI SERVICE ====================
AI_PORT=8000
ENVIRONMENT=development
AI_SERVICE_URL=http://localhost:8000

# ==================== JIRA ====================
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ

# ==================== GITHUB ====================
GITHUB_TOKEN=your_github_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_REPO=org/repo-name

# ==================== GROQ ====================
GROQ_API_KEY=your_groq_api_key

# ==================== RAG EMBEDDINGS ====================
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSIONS=1536

# ==================== INNGEST ====================
# Use Inngest Cloud (Event Key) or local dev.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV_URL=

# ==================== SLACK ====================
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_SIGNING_SECRET=your_signing_secret
SLACK_STANDUP_CHANNEL=standup

# ==================== MEETINGS WEBHOOK ====================
# Used by app/api/webhooks/daily/route.ts to validate Daily signatures.
DAILY_WEBHOOK_HMAC_SECRET=

# ==================== NEXTAUTH ====================
NEXTAUTH_URL=http://localhost:3000

# ==================== FRONTEND ====================
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_PORT=3000
