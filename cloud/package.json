{
  "name": "agile-scrum-master",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev -p 3000",
    "dev:api": "npm run dev --prefix backend/api-gateway",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "init:app-db": "node tools/init-nextjs-db.mjs",
    "desktop:install": "npm --prefix desktop run install:frontend",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:start": "npm --prefix desktop run start",
    "desktop:build": "npm --prefix desktop run build:frontend",
    "desktop:pack": "npm --prefix desktop run pack",
    "desktop:dist": "npm --prefix desktop run dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.36.0",
    "groq-sdk": "^0.12.0",
    "inngest": "^3.33.0",
    "lenis": "^1.3.18",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^2.15.4",
    "socket.io-client": "^4.8.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
