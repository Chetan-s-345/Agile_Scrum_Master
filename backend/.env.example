# Universal DB (Supabase or main Neon project)
UNIVERSAL_DATABASE_URL=postgresql://user:password@host/universal_db

# Tenant DB strategy
# - manual: user provides tenantDbConnectionString during signup
# - neon: gateway provisions a Neon branch per org
TENANT_DB_PROVISIONING_MODE=manual

# Neon API (for creating org branches)
NEON_API_KEY=your_neon_api_key
NEON_PROJECT_ID= 
NEON_BASE_BRANCH_ID=br-  #the branch with org_schema.sql applied

# Optional: used for Neon connection URI generation if UNIVERSAL_DATABASE_URL is not a Neon URL
NEON_DATABASE_NAME=
NEON_ROLE_NAME=

# Transactional Email (Brevo)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=

# Auth
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_secret
REFRESH_EXPIRES_IN=30d

# Redis
REDIS_URL=redis://localhost:6379

# AI Service
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Jira OAuth
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret

# GitHub
GITHUB_WEBHOOK_SECRET=your_webhook_secret
